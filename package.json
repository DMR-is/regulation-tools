    "eslint-plugin-total-functions",
    "eslint-plugin-unused-imports",
    "prettier"
  ],
  "dist_package_json": {
    "engines": {
      "node": ">=14.15 <21"
    }
  },
  "packageManager": "yarn@3.3.1"
}
