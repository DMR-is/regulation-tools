{
  "name": "@dmr.is/regulations-tools",
  "version": "1.0.0-next.1",
  "description": "Editing tools for Reglugerðir",
  "author": "Hugsmiðjan ehf. (www.hugsmidjan.is)",
  "contributors": [
    "Már Örlygsson <mar@hugsmidjan.is>"
  ],
  "license": "MIT",
  "repository": "ssh://git@github.com:DMR-is/regulation-tools.git",
  "engines": {
    "node": "20",
    "yarn": ">=1.22"
  },
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly --declaration --project tsconfig.json",
    "build": "tsc --noEmit  &&  yarn typecheck:react18  &&  node build.js && yarn build:types  &&  yarn run test",
    "typecheck:react18": "tsc -p tsconfig.react18.json",
    "prepublishOnly": "echo \"\nRun 'yarn run publishdist' to publish this package\n\n\"  && exit 1",
    "publishdist": "yarn test  &&  yarn build  &&  cd dist  &&  npm publish --tag $(node -p \"require('./package.json').version.includes('-') ? 'next' : 'latest'\")",
    "test": "jest",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@hugsmidjan/htmldiff-js": "^1.3.0",
    "@hugsmidjan/qj": "^4.10.2",
    "@tinymce/tinymce-react": "^3.13.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-blockquote": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-horizontal-rule": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "cleanup-prettier": "npm:prettier@2.2.0",
    "date-fns": "^2.29.3",
    "jsdom": "^16.4.0",
    "lucide-react": "1.55.0",
    "mammoth": "^1.8.0",
    "tinymce": "^5.10.2",
    "translate.js": "^1.3.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@hugsmidjan/hxmstyle": "^6.3.1",
    "@playwright/test": "1.48.2",
    "@types/cleanup-prettier": "npm:@types/prettier@2.1.6",
    "@types/jest": "^27.0.3",
    "@types/jsdom": "^16.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.36.2",
    "@typescript-eslint/parser": "^5.36.2",
    "concurrently": "^7.6.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-deprecation": "^1.3.2",
    "eslint-plugin-destructure-depth": "^1.0.3",
    "eslint-plugin-destructuring": "^2.2.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-total-functions": "^6.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "glob": "^10.3.12",
    "jest": "^29.4.1",
    "playwright": "1.48.2",
    "prettier": "^2.7.1",
    "react": "19.3.0",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.3.0",
    "react-dom-18": "npm:react-dom@18.3.1",
    "ts-jest": "^29.0.5",
    "types-react-18": "npm:@types/react@18.3.28",
    "types-react-dom-18": "npm:@types/react-dom@18.3.7",
    "typescript": "^5.4.5"
  },
  "dependenciesAdded": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint",
    "eslint-config-prettier",
    "eslint-plugin-deprecation",
    "eslint-plugin-destructure-depth",
    "eslint-plugin-destructuring",
    "eslint-plugin-import",
    "eslint-plugin-prettier",
